#!/usr/bin/env bash
# Install the matching C header and shared library into the project.
set -euo pipefail
unset CDPATH
root=$(cd "$(dirname "$0")/.." && pwd)
version=1.5.6
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)
    platform=linux-amd64
    digest=b845005f5132a7d8180057c35e14a7626632258782f871a90861b19c1c03841b
    library=libduckdb.so ;;
  Linux-aarch64)
    platform=linux-arm64
    digest=b72ed9f05003f5e9d2015f7ceada6416b377d9dd33169cdde3c9e33897856eee
    library=libduckdb.so ;;
  Darwin-arm64|Darwin-x86_64)
    platform=osx-universal
    digest=e0bc007d9b0094c0970ac1847a8601d10aad07cbd2910ce586ec810f77b638d6
    library=libduckdb.dylib ;;
  *) echo "No pinned DuckDB binary for $(uname -sm). Set DUCKDB_DIR to a DuckDB $version C distribution." >&2; exit 1 ;;
esac
deps="$root/.deps"
destination="$deps/duckdb"
mkdir -p "$deps"
if [[ -s "$destination/duckdb.h" && -s "$destination/$library" && -e "$destination/$digest" ]]; then
  exit 0
fi
stage=$(mktemp -d "$deps/download.XXXXXX")
trap 'rm -rf "$stage"' EXIT
curl -fLsS --retry 2 "https://github.com/duckdb/duckdb/releases/download/v$version/libduckdb-$platform.zip" -o "$stage/archive.zip"
if command -v sha256sum >/dev/null; then
  actual=$(sha256sum "$stage/archive.zip")
else
  actual=$(shasum -a 256 "$stage/archive.zip")
fi
[[ ${actual%% *} == "$digest" ]] || { echo "DuckDB archive checksum mismatch" >&2; exit 1; }
unzip -q "$stage/archive.zip" duckdb.h "$library" -d "$stage"
mkdir -p "$destination"
mv "$stage/duckdb.h" "$stage/$library" "$destination/"
touch "$destination/$digest"

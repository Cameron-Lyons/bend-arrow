#!/usr/bin/env bash
set -euo pipefail
if (( $# < 2 )); then
  echo "Usage: scripts/build INPUT.bend OUTPUT [extra compiler or linker arguments ...]" >&2
  exit 2
fi
root=$(cd "$(dirname "$0")/.." && pwd)
input=$1
output=$2
shift 2
if [[ -z ${DUCKDB_DIR:-} ]]; then
  "$root/scripts/fetch-duckdb"
  DUCKDB_DIR="$root/.deps/duckdb"
fi
duckdb_dir=$(cd "$DUCKDB_DIR" && pwd)
if [[ -z ${BEND_ARROW_LIB_DIR:-} ]]; then
  make -s -C "$root" native DUCKDB_DIR="$duckdb_dir" CC="${CC:-clang}"
  BEND_ARROW_LIB_DIR="$root/build"
fi
bridge_dir=$(cd "$BEND_ARROW_LIB_DIR" && pwd)
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
"${BEND:-bend}" "$input" -o "$stage/program.c"
"${CC:-clang}" -O2 -pthread -I"$root/native" -I"$duckdb_dir" \
  "$stage/program.c" "$@" -L"$bridge_dir" -Wl,-rpath,"$bridge_dir" -lbendarrow \
  -L"$duckdb_dir" -Wl,-rpath,"$duckdb_dir" -lduckdb -lm -o "$output"
